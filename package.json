{
  "name": "opencode-desktop-notes",
  "version": "0.1.0",
  "description": "A notes, side-question (/btw) and todo panel for OpenCode Desktop. Jot notes, ask the model side questions without touching the main chat, annotate chat text and send anything back to the agent.",
  "type": "module",
  "license": "MIT",
  "author": "wannabemrrobot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wannabemrrobot/opencode-desktop-notes.git"
  },
  "homepage": "https://github.com/wannabemrrobot/opencode-desktop-notes#readme",
  "bugs": "https://github.com/wannabemrrobot/opencode-desktop-notes/issues",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-desktop",
    "notes",
    "todo",
    "btw",
    "side-questions"
  ],
  "exports": {
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "bundle": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit --jsx preserve --jsxImportSource solid-js --moduleResolution bundler --module esnext --target es2022 --skipLibCheck --strict src/gui.tsx",
    "demo": "vite build --config demo/vite.config.ts"
  },
  "devDependencies": {
    "@opencode/plugin": "2.2.7",
    "lucide-solid": "^1.72.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vite-plugin-solid": "^2.11.0"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.2.0"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  }
}
